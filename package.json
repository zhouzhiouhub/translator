{
  "name": "kinolin-translator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run sync:prompt && next dev --hostname 127.0.0.1 --port 3000",
    "sync:prompt": "node scripts/sync-prompt.mjs",
    "build": "npm run sync:prompt && opennextjs-cloudflare build",
    "build:next": "npm run sync:prompt && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/**/*.test.ts",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "next-intl": "^4.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.11.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.40.0"
  }
}
